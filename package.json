{
  "name": "@walak-dev/ruta",
  "version": "0.2.0",
  "description": "Think-first model routing. Before a token is spent, Ruta decides the cheapest path that will work: no AI, cached, small or frontier. Risk-aware, explainable, budget-first, open source.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "default": "./dist/adapters/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ruta": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/EVAL.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "typecheck:all": "tsc -p tsconfig.all.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "bundle": "node scripts/bundle.mjs",
    "build:skill": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node18 --log-level=warning --outfile=claude/skills/ruta/scripts/ruta.mjs",
    "build:mcp": "npm --prefix mcp run build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:all": "npm run clean && npm run build && npm run bundle && npm run build:skill && npm run build:mcp",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "keywords": [
    "llm",
    "router",
    "model-routing",
    "ai-cost",
    "openrouter",
    "bedrock",
    "anthropic",
    "agents",
    "mcp",
    "lovable"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/walak-dev/ruta.git"
  },
  "peerDependencies": {
    "@aws-sdk/client-bedrock-runtime": ">=3"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-bedrock-runtime": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
